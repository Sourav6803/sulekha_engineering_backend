# ============================================
# PUPPETEER (PDF Generation)
# ============================================
# Puppeteer auto-discovers the Chromium it installed under
# %USERPROFILE%\.cache\puppeteer on Windows. The old value (/usr/bin/google-chrome)
# is a Linux path that does not exist here and caused every PDF launch to fail.
# Uncomment and point at a real binary to override discovery explicitly.
# PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
PUPPETEER_LAUNCH_ARGS=--no-sandbox,--disable-setuid-sandbox

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
LOG_DIR=./logs

# ============================================
# MONITORING
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# ============================================
# FEATURES FLAGS
# ============================================
ENABLE_PDF_GENERATION=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_AUDIT_LOGS=true
ENABLE_BACKGROUND_JOBS=true